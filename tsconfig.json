{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "nodenext",
    "target": "esnext",
    "strict": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "outDir": "dist"
  },

  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "generated/prisma"]
}
