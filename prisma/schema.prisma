generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PROVIDER
  ADMIN
  TENANT
}

model User { 
  id    Int     @id @default(autoincrement()) 
  email String  @unique
  name  String?
  role  Role    @default(TENANT)
} 